{
  "redirects": [
    {
      "source": "/",
      "destination": "/loja",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "https://vetrina-42b1.onrender.com/api/anuncios/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/loja/p/:id",
      "destination": "/api/seo?p=:id"
    },
    {
      "source": "/loja/s/:slug",
      "destination": "/api/seo?s=:slug"
    },
    {
      "source": "/loja",
      "destination": "/api/seo"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vetrina-42b1.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
